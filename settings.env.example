# Copy to settings.env (or run ./setup.sh, which generates strong values).
# settings.env is git-ignored. Keep it readable only by you: chmod 600 settings.env

# Admin password: at least 16 characters, with 3 of lowercase/uppercase/digits/
# symbols (or 24+ characters of anything). The app refuses to start otherwise.
ADMIN_PASSWORD=replace-with-a-strong-password

# Random secret used to sign the admin session cookie (64 hex chars).
SECRET_KEY=

# Set to true once the site is served over HTTPS (sends the cookie only over TLS).
COOKIE_SECURE=false

SITE_TITLE=Simple Games
MAX_UPLOAD_KB=5120
KEEP_VERSIONS=50
ADMIN_SESSION_HOURS=8
LOGIN_MAX_FAILURES=5
LOGIN_LOCKOUT_MINUTES=15

# false (default): games may not load anything from the internet (no CDNs,
# trackers or API calls) - everything must be inside the single HTML file.
# true: games may load scripts/images/fonts and call APIs over https.
GAMES_ALLOW_EXTERNAL_RESOURCES=false
