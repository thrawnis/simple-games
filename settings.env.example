# Copy to settings.env (or run ./setup.sh, which generates a random password).
# settings.env is git-ignored. Keep it readable only by you: chmod 600 settings.env

# Admin login. The username must be typed in at the login page.
ADMIN_USERNAME=admin

# Admin password. Any non-empty value is accepted (the app refuses to start
# with an empty one). Longer is better - this protects your admin area.
ADMIN_PASSWORD=replace-me

# Random secret used to sign the admin session cookie (64 hex chars).
SECRET_KEY=

# true: the admin cookie is only sent over HTTPS (via Nginx Proxy Manager or
# Cloudflare). Set to false only if you must log in over plain http://.
COOKIE_SECURE=true

# false (default): /admin is refused for requests that come through
# Cloudflare, so the admin area is only reachable on your local network.
# If you set this to true, protect /admin with Cloudflare Access as well.
ADMIN_VIA_CLOUDFLARE=false

SITE_TITLE=Simple Games
MAX_UPLOAD_KB=5120
KEEP_VERSIONS=50
ADMIN_SESSION_HOURS=1
LOGIN_MAX_FAILURES=5
LOGIN_LOCKOUT_MINUTES=15

# false (default): games may not load anything from the internet (no CDNs,
# trackers or API calls) - everything must be inside the single HTML file.
# true: games may load scripts/images/fonts and call APIs over https.
GAMES_ALLOW_EXTERNAL_RESOURCES=false
